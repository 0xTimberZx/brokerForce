# Supabase (database/API layer only; user data stays in browser storage per
# docs/Architecture.md §5)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (see docs/Database.md)
DATABASE_URL=
REDIS_URL=

# Market data APIs (see docs/Architecture.md §6 for the full list — add keys as integrations are built)
COINGECKO_API_KEY=
ALCHEMY_API_KEY=

# API server
PORT=4000

# Member gate (spec 022). Without these the API keeps data routes closed (503).
# Real values live in Vercel's environment settings, never in the repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_ID=
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# SESSION_TTL_DAYS=7
# Local development only: skip the gate for localhost. Refused in production.
# AUTH_DEV_BYPASS=1
